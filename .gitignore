# ── Data ─────────────────────────────────────────────
# Raw data is rebuilt by `python data/get_data.py` (repo conventions)
data/raw/
# Derived data is rebuilt by src/ cleaning + notebooks 02
data/interim/
data/processed/
# Safety net: never commit bulk data files anywhere
*.parquet
*.zip
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
# Keep the downloader and any small hand-written docs
!data/get_data.py
!data/README.md
!data/**/.gitkeep

# ── Models / artifacts ───────────────────────────────
models/*.joblib
models/*.pkl
artifacts/
mlruns/

# ── Python ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Environments ─────────────────────────────────────
.venv/
venv/
env/
.env
.env.*
!.env.example
.conda/

# ── Jupyter ──────────────────────────────────────────
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
